Bootstrap: docker
From: nvidia/cuda:13.2.1-cudnn-devel-ubuntu24.04

%files
    . /opt/simulon

%post
    export DEBIAN_FRONTEND=noninteractive
    export TZ=UTC

    export CUDA_HOME=/usr/local/cuda
    export PATH=$CUDA_HOME/bin:$PATH
    export LD_LIBRARY_PATH=$CUDA_HOME/lib64:$LD_LIBRARY_PATH

    apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        curl \
        git \
        libnccl2 \
        libnccl-dev \
        libssl-dev \
        ninja-build \
        wget \
        && rm -rf /var/lib/apt/lists/*

    curl -LsSf https://astral.sh/uv/install.sh | sh
    export PATH="$HOME/.local/bin:$PATH"

    uv python install 3.13

    cd /opt/simulon

    rm -rf .venv output build **/__pycache__ **/*.egg-info .pytest_cache

    git submodule update --init --recursive

    uv sync --extra dev

    export PATH="/opt/simulon/.venv/bin:$PATH"

    uv pip install pip

    uv run python setup.py build_ext --inplace

    uv pip install transformer_engine_cu13==2.11.0 transformer_engine[pytorch]==2.11.0

    uv run simulon install flash-attn-hopper --version 2.8.3 --prebuilt
    uv run simulon install deepgemm

    export TORCH_CUDA_ARCH_LIST="9.0"
    uv run simulon install apex --skip-cuda-version-check

%environment
    export PYTHONUNBUFFERED=1
    export CUDA_HOME=/usr/local/cuda
    export PATH="/opt/simulon/.venv/bin:$CUDA_HOME/bin:$PATH"
    export LD_LIBRARY_PATH="$CUDA_HOME/lib64:$LD_LIBRARY_PATH"
    export PYTHONPATH="/opt/simulon:$PYTHONPATH"

%runscript
    exec "$@"
